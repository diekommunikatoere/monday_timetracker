{
	"name": "timetracker",
	"version": "0.9.2",
	"private": true,
	"scripts": {
		"dev": "npm run services:start && concurrently \"next dev\" \"npm run expose\"",
		"build": "next build",
		"start": "next start",
		"expose": "mapps tunnel:create -p 8301",
		"stop": "kill-port 8301 && kill-port 4049 && kill-port 4040",
		"services:start": "docker-compose up -d && supabase start",
		"services:stop": "docker-compose down && supabase stop",
		"services:restart": "npm run services:stop && npm run services:start",
		"db:migrate": "supabase db push",
		"db:reset": "supabase db reset",
		"db:studio": "open http://localhost:54323",
		"db:seed": "supabase db reset --db-only",
		"redis:cli": "docker exec -it timetracker_redis redis-cli",
		"redis:flush": "docker exec -it timetracker_redis redis-cli FLUSHALL",
		"redis:gui": "open http://localhost:8081",
		"supabase:status": "supabase status",
		"supabase:logs": "supabase logs"
	},
	"dependencies": {
		"@mantine/core": "^8.3.14",
		"@mantine/dates": "^8.3.14",
		"@mantine/hooks": "^8.3.14",
		"@mantine/notifications": "^8.3.14",
		"@mondaydotcomorg/api": "^13.0.0",
		"@supabase/supabase-js": "^2.94.0",
		"@tanstack/react-query": "^5.90.20",
		"ioredis": "^5.9.2",
		"jsonwebtoken": "^9.0.3",
		"monday-sdk-js": "^0.5.7",
		"next": "16.1.4",
		"postcss": "^8.5.6",
		"postcss-preset-mantine": "^1.18.0",
		"postcss-simple-vars": "^7.0.1",
		"react": "19.2.3",
		"react-dom": "19.2.3",
		"sass": "^1.97.3",
		"zustand": "^5.0.11"
	},
	"devDependencies": {
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^20.19.31",
		"@types/react": "19.2.9",
		"@types/react-dom": "19.2.3",
		"concurrently": "^9.2.1",
		"cross-port-killer": "^1.4.0",
		"supabase": "^2.75.2",
		"typescript": "^5.9.3"
	},
	"overrides": {
		"@types/react": "19.2.9",
		"@types/react-dom": "19.2.3"
	}
}
