{
	"plugins": ["react", "nextjs", "import", "typescript", "jsx-a11y"],
	"categories": {
		"correctness": "error",
		"suspicious": "warn"
	},
	"rules": {
		// This codebase is non-strict TS (see CLAUDE.md) and uses `any` intentionally in places —
		// surface it, don't fail the lint run over existing usage.
		"typescript/no-explicit-any": "warn",
		"eslint/no-unused-vars": "warn",
		// Next.js uses the automatic JSX runtime — React need not be in scope.
		"react/react-in-jsx-scope": "off",
		// Side-effect CSS imports (app/layout.tsx) are the standard Next.js pattern.
		"import/no-unassigned-import": "off",
		// Conflicts with the `_`-prefix convention no-unused-vars recommends.
		"eslint/no-underscore-dangle": "off",
		// Was "warn" under eslint-config-next; keep that severity so lint stays green
		// while the 12 pre-existing violations get worked through.
		"react-hooks/exhaustive-deps": "warn"
	},
	"ignorePatterns": ["types/database/database.ts"]
}
